# SKELETON for Lab 1. Fill in commands from your own Lab 1 (paths are examples).
# Put this Makefile in the root of the Lab 1 project.
run-all: c cpp python js ts java csharp fsharp go rust bash prolog asm

c:
	@echo "===== C ====="
	gcc c/main.c -o c/main
	./c/main

cpp:
	@echo "===== C++ ====="
	g++ cpp/main.cpp -o cpp/main
	./cpp/main

python:
	@echo "===== Python ====="
	python3 python/main.py

js:
	@echo "===== JavaScript ====="
	node javascript/main.js

ts:
	@echo "===== TypeScript ====="
	@echo "TODO: tsc typescript/main.ts && node typescript/main.js"

java:
	@echo "===== Java ====="
	@echo "TODO: javac + java"

csharp:
	@echo "===== C# ====="
	@echo "TODO"

fsharp:
	@echo "===== F# ====="
	@echo "TODO"

go:
