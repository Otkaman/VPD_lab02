	@echo "TODO: go run go/main.go"

rust:
	@echo "===== Rust ====="
	@echo "TODO: rustc rust/main.rs -o rust/main && ./rust/main"

bash:
	@echo "===== Bash ====="
	@echo "TODO: bash bash/main.sh"

prolog:
	@echo "===== Prolog ====="
	@echo "TODO: swipl ..."

asm:
	@echo "===== Assembler ====="
	@echo "TODO: depends on your arch/OS"

clean:
	rm -f c/main cpp/main
	@echo "TODO: remove other build artifacts"

.PHONY: run-all c cpp python js ts java csharp fsharp go rust bash prolog asm clean
